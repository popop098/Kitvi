{
  "name": "kitvi",
  "productName": "Kitvi",
  "version": "0.7.0",
  "description": "Kitvi — a Windows PC dashboard with sandboxed community plugins",
  "author": "Kitvi",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "build/electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:electron": "node node_modules/electron/install.js",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "design:preview": "node scripts/design.mjs",
    "design:dev": "node scripts/design.mjs --watch",
    "build:ui": "node scripts/build.mjs",
    "build:native": "node scripts/native.mjs publish",
    "build": "npm run typecheck && npm run build:ui && npm run build:native",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:native": "node scripts/native.mjs checks",
    "start": "npm run build && node scripts/launch.mjs",
    "package": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "package:themes": "node scripts/package-themes.mjs"
  },
  "devDependencies": {
    "@astryxdesign/core": "0.7.14",
    "@astryxdesign/theme-neutral": "0.7.14",
    "@astryxdesign/cli": "0.7.14",
    "@stylexjs/stylex": "0.19.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "lucide-react": "0.468.0",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "@types/yauzl": "3.4.0",
    "@types/semver": "7.8.0"
  },
  "build": {
    "appId": "com.popop098.kitvi",
    "productName": "Kitvi",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/publish",
        "to": "collector",
        "filter": [
          "**/*",
          "!**/*.pdb"
        ]
      },
      {
        "from": "docs/사용 안내.txt",
        "to": "사용 안내.txt"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "Kitvi-${version}-win-x64.${ext}",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "assets/kitvi.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Kitvi-Setup-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "popop098",
        "repo": "Kitvi",
        "releaseType": "prerelease"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "yauzl": "3.4.0",
    "semver": "7.8.6"
  }
}
